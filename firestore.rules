rules_version = '2';

// Paste into Firebase console > Firestore Database > Rules, then Publish.
//
// Each family's data lives under households/{code}. The code is 10 random characters, so it can't be
// guessed; only people who know it can read or write that family's list. Listing all households is not
// allowed, and only signed-in (anonymous is fine) users get access at all.
service cloud.firestore {
  match /databases/{database}/documents {
    match /households/{household} {
      allow get, create: if request.auth != null;

      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
